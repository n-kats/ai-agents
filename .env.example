# PostgreSQL channel queue settings
NKAA_CONTAINER_PREFIX=nkaa
NKAA_CHANNEL_DB_STORAGE=./_data/channel-db
NKAA_CHANNEL_DB_PORT=5433
NKAA_CHANNEL_DATABASE_URL=postgresql+psycopg://nkaa:nkaa@nkaa-channel-db:5432/nkaa

## Opik logging (optional)
##  NKAA_OPIK_URL を設定すると LLM 呼び出し結果を指定先の Opik へ送信する。
# NKAA_OPIK_URL=http://localhost:5173/api/
# NKAA_OPIK_PROJECT_NAME=xxxx_project
